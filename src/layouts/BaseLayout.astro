---
import BaseHead from '../components/BaseHead.astro';
import CategoryNavScript from '../components/CategoryNavScript.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { getLineConfig } from '../lines';
import type { ImageMetadata } from 'astro';

interface Props {
	title: string;
	description: string;
	image?: ImageMetadata | string;
}

const { title, description, image } = Astro.props;
const line = getLineConfig();
---

<!doctype html>
<html lang="zh-CN" data-site-line={line.id} data-texture={line.texture} data-motion={line.motion}>
	<head>
		<BaseHead title={title} description={description} image={image} />
	</head>
	<body>
		<div class="texture-layer" aria-hidden="true"></div>
		<div class="site-shell" data-category-swipe>
			<Header />
			<slot />
			<Footer />
		</div>
		<CategoryNavScript />
		<script>
			const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
			if (!reduce) {
				const nodes = document.querySelectorAll('.reveal-on-scroll');
				if (nodes.length && 'IntersectionObserver' in window) {
					const io = new IntersectionObserver(
						(entries) => {
							for (const entry of entries) {
								if (entry.isIntersecting) {
									entry.target.classList.add('is-visible');
									io.unobserve(entry.target);
								}
							}
						},
						{ rootMargin: '0px 0px -8% 0px', threshold: 0.12 }
					);
					nodes.forEach((el) => io.observe(el));
				} else {
					nodes.forEach((el) => el.classList.add('is-visible'));
				}
			} else {
				document.querySelectorAll('.reveal-on-scroll').forEach((el) => {
					el.classList.add('is-visible');
				});
			}
		</script>
	</body>
</html>
