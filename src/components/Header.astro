---
import { getForumCategories, getForumPostIndex, getSiteMeta } from '../lib/forum';
import { getLineConfig } from '../lines';
import { normalizePathname } from '../lib/path';
import HeaderLink from './HeaderLink.astro';

const line = getLineConfig();
const meta = getSiteMeta();
const forumCategories = getForumCategories();

const brandPrimary =
	line.heroPrimary === 'project_codename' ? meta.project_codename : meta.site_brand;
const brandSecondary =
	line.heroSecondary === 'site_brand' ? meta.site_brand : meta.project_codename;

const normalized = normalizePathname(Astro.url.pathname);
const isHome = normalized === '/';

/** Detail `/logs/:id` should light up its category nav item */
let activeCategoryId: number | null = null;
const catMatch = normalized.match(/^\/logs\/c\/(\d+)$/);
const postMatch = normalized.match(/^\/logs\/(\d+)$/);
if (catMatch) {
	activeCategoryId = Number(catMatch[1]);
} else if (postMatch) {
	const post = getForumPostIndex().find((p) => Number(p.id) === Number(postMatch[1]));
	if (post?.category_id != null) activeCategoryId = Number(post.category_id);
}
---

<header class="site-header">
	<nav class="container nav" aria-label="主导航">
		<a class="brand" href="/">
			<span class="brand-name">{brandPrimary}</span>
			<span class="brand-code">{brandSecondary}</span>
		</a>
		<div class="links-wrap">
			<div class="links" data-nav-scroll>
				<HeaderLink href="/" active={isHome}>首页</HeaderLink>
				{
					forumCategories.length > 0 ? (
						forumCategories.map((cat) => (
							<HeaderLink
								href={`/logs/c/${cat.id}/`}
								active={activeCategoryId === Number(cat.id)}
							>
								{cat.name}
							</HeaderLink>
						))
					) : (
						<HeaderLink href="/logs/">日志</HeaderLink>
					)
				}
			</div>
		</div>
	</nav>
</header>

<style>
	.site-header {
		position: sticky;
		top: 0;
		z-index: 20;
		backdrop-filter: blur(12px);
		background: var(--header-bg);
		border-bottom: 1px solid var(--line);
	}

	.nav {
		display: flex;
		align-items: center;
		gap: 1rem;
		min-height: 4rem;
	}

	.brand {
		display: flex;
		flex-direction: column;
		flex-shrink: 0;
		text-decoration: none;
		color: var(--ink);
		line-height: 1.1;
	}

	.brand-name {
		font-family: var(--font-display);
		font-weight: 800;
		font-size: 1.15rem;
		letter-spacing: -0.03em;
	}

	.brand-code {
		font-size: 0.72rem;
		color: var(--ink-soft);
		letter-spacing: 0.04em;
		text-transform: uppercase;
	}

	.links-wrap {
		flex: 1;
		min-width: 0;
		position: relative;
		mask-image: linear-gradient(
			90deg,
			transparent 0,
			#000 0.75rem,
			#000 calc(100% - 0.75rem),
			transparent 100%
		);
	}

	.links {
		display: flex;
		flex-wrap: nowrap;
		align-items: center;
		gap: 0.15rem 0.85rem;
		overflow-x: auto;
		overflow-y: hidden;
		-webkit-overflow-scrolling: touch;
		scrollbar-width: thin;
		scroll-snap-type: x proximity;
		scroll-padding-inline: 0.5rem;
		padding-block: 0.35rem;
		padding-inline: 0.15rem;
	}

	.links::-webkit-scrollbar {
		height: 3px;
	}

	.links::-webkit-scrollbar-thumb {
		background: rgba(21, 32, 43, 0.2);
		border-radius: 99px;
	}

	.links :global(a) {
		flex: 0 0 auto;
		color: var(--ink-soft);
		text-decoration: none;
		font-size: 0.92rem;
		font-weight: 500;
		padding: 0.4rem 0.15rem;
		border-bottom: 2px solid transparent;
		scroll-snap-align: center;
		white-space: nowrap;
		transition:
			color 0.2s var(--ease),
			border-color 0.2s var(--ease);
	}

	.links :global(a:hover),
	.links :global(a.active) {
		color: var(--ink);
		border-bottom-color: var(--accent);
	}

	@media (max-width: 720px) {
		.nav {
			flex-direction: column;
			align-items: stretch;
			padding-block: 0.75rem;
			gap: 0.55rem;
			min-height: 0;
		}

		.links-wrap {
			margin-inline: -0.15rem;
		}

		.links {
			gap: 0.15rem 1rem;
			padding-inline: 0.25rem;
		}

		.links :global(a) {
			font-size: 0.95rem;
			padding: 0.45rem 0.2rem;
		}
	}
</style>
