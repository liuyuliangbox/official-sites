---
import CoverPlaceholder from '../components/CoverPlaceholder.astro';
import FormattedDate from '../components/FormattedDate.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { APP_URL, BBS_URL } from '../consts';
import { getLineConfig } from '../lines';
import { getSiteFeaturedPosts, getSiteMeta, parseForumDate } from '../lib/forum';

const line = getLineConfig();
const meta = getSiteMeta();
const posts = getSiteFeaturedPosts(3);
const productLine = meta.product_tagline || meta.working_title_note;
const communityHome = meta.community_home_url || BBS_URL;

const primaryText =
	line.heroPrimary === 'project_codename' ? meta.project_codename : meta.site_brand;
const secondaryText =
	line.heroSecondary === 'site_brand' ? meta.site_brand : meta.project_codename;

const primaryHref =
	line.primaryCtaKind === 'app' && APP_URL ? APP_URL : '#featured';
const primaryLabel =
	line.primaryCtaKind === 'app' && !APP_URL
		? '最新社区精选'
		: line.primaryCtaLabel;
---

<BaseLayout title={meta.site_brand} description={meta.site_description}>
	<section class="hero">
		<div class="hero-plane" aria-hidden="true"></div>
		<div class="mist" aria-hidden="true"></div>
		<div class="container hero-inner">
			<p class="eyebrow fade-up">{secondaryText}</p>
			<h1 class="hero-brand fade-up-delay">{primaryText}</h1>
			<p class="tagline fade-up-delay-2">{productLine}</p>
			{
				meta.working_title_note && meta.working_title_note !== productLine ? (
					<p class="note fade-up-delay-2">{meta.working_title_note}</p>
				) : null
			}
			<div class="cta fade-up-delay-3">
				<a class="btn btn-primary" href={primaryHref}>{primaryLabel}</a>
				<a
					class="btn btn-ghost"
					href={communityHome}
					target="_blank"
					rel="noopener noreferrer"
				>
					{line.secondaryCtaLabel}
				</a>
			</div>
		</div>
	</section>

	<section id="featured" class="container section latest">
		<div class="section-head reveal-on-scroll">
			<h2>最新社区精选</h2>
			<a href={communityHome} target="_blank" rel="noopener noreferrer">查看更多</a>
		</div>
		{
			posts.length === 0 ? (
				<p class="empty reveal-on-scroll">
					暂无社区精选。在社区后台将帖子标为「官网精选」后，重建官网即可出现在此。
				</p>
			) : (
				<ul class="log-list">
					{posts.map((post, i) => (
						<li class="reveal-on-scroll" style={`--reveal-i:${i}`}>
							<p class="meta">
								<FormattedDate date={parseForumDate(post.created_at)} />
								{post.category_name ? <> · {post.category_name}</> : null}
								{post.author_name ? <> · {post.author_name}</> : null}
							</p>
							<a href={`/logs/${post.id}/`}>
								{post.cover_url ? (
									<img
										class="cover"
										src={post.cover_url}
										alt=""
										loading="lazy"
										referrerpolicy="no-referrer"
									/>
								) : (
									<CoverPlaceholder label={post.category_name} />
								)}
								<span class="body">
									<span class="title">{post.title}</span>
									{post.summary ? <span class="summary">{post.summary}</span> : null}
								</span>
							</a>
						</li>
					))}
				</ul>
			)
		}
	</section>
</BaseLayout>

<style>
	.hero {
		position: relative;
		min-height: min(92vh, 52rem);
		display: grid;
		align-items: end;
		overflow: hidden;
		isolation: isolate;
	}

	.hero-plane {
		position: absolute;
		inset: 0;
		z-index: -2;
		background: var(--hero-plane);
		animation: planeShift 22s ease-in-out infinite alternate;
	}

	.mist {
		position: absolute;
		inset: 0;
		z-index: -1;
		pointer-events: none;
		background:
			radial-gradient(ellipse 60% 35% at 50% 88%, rgba(238, 243, 247, 0.14), transparent 70%),
			radial-gradient(ellipse 40% 25% at 30% 60%, rgba(200, 220, 220, 0.06), transparent 65%);
		animation: mistDrift 16s ease-in-out infinite alternate;
	}

	:global(html[data-site-line='paint']) .mist {
		background:
			radial-gradient(ellipse 55% 30% at 48% 90%, rgba(250, 250, 248, 0.12), transparent 70%),
			radial-gradient(ellipse 35% 22% at 70% 40%, rgba(31, 107, 92, 0.08), transparent 65%);
	}

	.hero-plane::after {
		content: '';
		position: absolute;
		inset: 0;
		background-image:
			linear-gradient(rgba(255, 255, 255, 0.035) 1px, transparent 1px),
			linear-gradient(90deg, rgba(255, 255, 255, 0.035) 1px, transparent 1px);
		background-size: 64px 64px;
		opacity: 0.28;
		mask-image: linear-gradient(180deg, #000 15%, transparent 88%);
	}

	:global(html[data-site-line='paint']) .hero-plane::after {
		background-size: 32px 32px;
		opacity: 0.22;
	}

	@keyframes planeShift {
		from {
			filter: saturate(1) brightness(1);
			transform: scale(1);
		}
		to {
			filter: saturate(1.05) brightness(1.025);
			transform: scale(1.02);
		}
	}

	@keyframes mistDrift {
		from {
			opacity: 0.85;
			transform: translateY(0);
		}
		to {
			opacity: 1;
			transform: translateY(-1.1%);
		}
	}

	.hero-inner {
		padding: 6rem 0 4.5rem;
		color: var(--hero-ink);
	}

	.eyebrow {
		margin: 0 0 0.65rem;
		font-family: var(--font-display);
		font-size: 0.95rem;
		font-weight: 600;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		color: var(--hero-muted);
	}

	.hero-brand {
		margin: 0 0 1rem;
		font-family: var(--font-display);
		font-size: clamp(2.6rem, 9vw, 5.4rem);
		font-weight: 800;
		letter-spacing: -0.045em;
		line-height: 0.95;
		color: #fff;
		text-shadow: 0 10px 40px rgba(0, 0, 0, 0.25);
	}

	:global(html[data-site-line='paint']) .hero-brand {
		letter-spacing: -0.035em;
		text-shadow: 0 12px 36px rgba(0, 0, 0, 0.28);
	}

	.tagline {
		max-width: 30rem;
		margin: 0 0 0.65rem;
		color: rgba(238, 243, 247, 0.92);
		font-size: 1.12rem;
		line-height: 1.55;
	}

	.cta {
		display: flex;
		flex-wrap: wrap;
		gap: 0.75rem;
		margin-top: 1.35rem;
	}

	.note {
		margin: 0;
		font-size: 0.85rem;
		color: var(--hero-muted);
	}

	.section {
		padding: 3.5rem 0 2rem;
	}

	.section-head {
		display: flex;
		align-items: baseline;
		justify-content: space-between;
		gap: 1rem;
		margin-bottom: 1.5rem;
	}

	.section-head h2 {
		font-size: 1.6rem;
	}

	.section-head a {
		text-decoration: none;
		font-weight: 600;
		font-size: 0.95rem;
		color: var(--accent);
		border-bottom: 1px solid transparent;
		transition: border-color 0.2s var(--ease);
	}

	.section-head a:hover {
		border-bottom-color: var(--accent);
	}

	.empty {
		color: var(--ink-soft);
	}

	.log-list {
		list-style: none;
		margin: 0;
		padding: 0;
		display: grid;
		gap: 0;
	}

	.log-list li {
		padding-top: 0.85rem;
		transition-delay: calc(var(--reveal-i, 0) * 60ms);
	}

	.log-list li + li {
		margin-top: 0.35rem;
	}

	.meta {
		margin: 0 0 0.55rem;
		font-size: 0.9rem;
		color: var(--ink-soft);
		text-align: left;
	}

	.log-list a {
		display: grid;
		grid-template-columns: 7.5rem 1fr;
		gap: 0.85rem 1.25rem;
		align-items: start;
		padding: 1rem 0 1.15rem;
		border-top: 1px solid var(--line);
		text-decoration: none;
		color: inherit;
		transition: padding-left 0.25s var(--ease);
	}

	.log-list a:hover {
		padding-left: 0.35rem;
	}

	.cover {
		width: 7.5rem;
		height: 5.25rem;
		object-fit: cover;
		border-radius: 0.45rem;
		background: rgba(28, 42, 56, 0.08);
	}

	.body {
		display: flex;
		flex-direction: column;
		gap: 0.35rem;
		min-width: 0;
		padding-top: 0.15rem;
	}

	.title {
		font-family: var(--font-display);
		font-size: 1.25rem;
		font-weight: 700;
		color: var(--ink);
		line-height: 1.3;
	}

	.summary {
		color: var(--ink-soft);
		font-size: 0.95rem;
		line-height: 1.55;
		display: -webkit-box;
		-webkit-line-clamp: 2;
		-webkit-box-orient: vertical;
		overflow: hidden;
	}

	@media (prefers-reduced-motion: reduce) {
		.hero-plane,
		.mist {
			animation: none !important;
		}
	}

	@media (max-width: 720px) {
		.hero-inner {
			padding-top: 4.5rem;
		}

		.log-list a {
			grid-template-columns: 5.5rem 1fr;
			gap: 0.75rem 0.9rem;
		}

		.cover {
			width: 5.5rem;
			height: 4rem;
		}
	}
</style>
