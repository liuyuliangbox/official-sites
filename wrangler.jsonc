{
	"$schema": "node_modules/wrangler/config-schema.json",
	// Official site (game line). Worker name = site-{line}.
	"name": "site-game",
	"main": "workers/site.js",
	"compatibility_date": "2025-09-27",
	"assets": {
		"directory": "./dist",
		"binding": "ASSETS",
		"not_found_handling": "404-page"
	},
	"observability": {
		"enabled": true
	},
	"routes": [
		{
			"pattern": "site-game.aridjaya.eu.org",
			"custom_domain": true
		}
	]
}
